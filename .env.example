# ============================================================================
# VIP PRODUCT STUDIO — MVP-01
# Copy file này thành `.env` rồi điền giá trị thật.
# KHÔNG BAO GIỜ commit `.env`. Không hardcode secret trong mã nguồn.
# ============================================================================

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Gốc URL công khai, dùng cho link chia sẻ/history. Để trống = tự suy ra.
PUBLIC_BASE_URL=

# ── Storage ─────────────────────────────────────────────────────────────────
# sqlite (mặc định, dùng node:sqlite built-in) | postgres
DB_DRIVER=sqlite
SQLITE_PATH=./data/studio.db
# Bật khi chạy PostgreSQL. Ví dụ:
# postgres://studio:studio@127.0.0.1:5432/studio
DATABASE_URL=
PGSSLMODE=disable
PG_POOL_MAX=10

# ── AI: Content Engine (G09) ────────────────────────────────────────────────
# deepseek | openai | anthropic | gemini | mock
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=120000
AI_MAX_OUTPUT_TOKENS=4096
AI_TEMPERATURE=0.4

# ── AI: Vision Provider (G07) ───────────────────────────────────────────────
# Để trống = dùng chung cấu hình AI_* ở trên.
VISION_PROVIDER=
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
VISION_TIMEOUT_MS=120000
# Số ảnh tối đa gửi sang Vision trong một lần phân tích.
VISION_MAX_IMAGES=6

# ── Session cho sàn cần đăng nhập (G05) ─────────────────────────────────────
# none  = chỉ truy cập ẩn danh, gặp tường đăng nhập thì báo LOGIN_REQUIRED
# file  = đọc cookie từ SESSION_COOKIE_FILE (file phải nằm ngoài git)
# cdp   = nối vào Chrome đang chạy với --remote-debugging-port (dùng profile thật)
SESSION_MODE=none
SESSION_COOKIE_FILE=./.session/cookies.json
CDP_ENDPOINT=http://127.0.0.1:9222
SESSION_REQUIRED_SOURCES=pinduoduo,taobao

# ── Network / Security ──────────────────────────────────────────────────────
# Chặn SSRF: cấm fetch vào IP nội bộ. Chỉ bật true khi test cục bộ có kiểm soát.
ALLOW_PRIVATE_NETWORK=false
# Timeout 1 request mạng ra ngoài (ms)
FETCH_TIMEOUT_MS=20000
# Số hop redirect tối đa; mỗi hop đều phải qua allowlist
FETCH_MAX_REDIRECTS=5
# Giới hạn dung lượng tải về cho 1 tài liệu/ảnh (byte)
MAX_FETCH_BYTES=8388608
# Giới hạn upload ảnh thủ công ở G11 (byte)
MAX_UPLOAD_BYTES=5242880
MAX_UPLOAD_FILES=12
# MIME được phép cho ảnh upload
ALLOWED_IMAGE_MIME=image/jpeg,image/png,image/webp,image/gif

# ── Rate limit (abstraction in-memory; production nên thay bằng Redis) ──────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_JOBS=10
RATE_LIMIT_MAX_REQUESTS=120

# ── Jobs ────────────────────────────────────────────────────────────────────
# Concurrency của worker nền
JOB_CONCURRENCY=2
JOB_MAX_ATTEMPTS=2

# ── Usage / Billing foundation (G13) ────────────────────────────────────────
# Đơn giá ước tính để tính estimated_cost. Chưa thu tiền thật.
COST_SOURCE_EXTRACT=0.0005
COST_VISION_ANALYSIS=0.0030
COST_TRANSLATION=0.0008
COST_CONTENT_GENERATE=0.0040
CREDIT_CURRENCY=USD
