# ============================================================================
# VIP PRODUCT STUDIO — MVP-01 + MVP-02 (dịch chữ Trung trên ảnh sản phẩm)
# Copy file này thành `.env` rồi điền giá trị thật.
# KHÔNG BAO GIỜ commit `.env`. Không hardcode secret trong mã nguồn.
# ============================================================================

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Gốc URL công khai, dùng cho link chia sẻ/history. Để trống = tự suy ra.
PUBLIC_BASE_URL=

# ── Storage ─────────────────────────────────────────────────────────────────
# sqlite (mặc định, dùng node:sqlite built-in) | postgres
DB_DRIVER=sqlite
SQLITE_PATH=./data/studio.db
# Bật khi chạy PostgreSQL. Ví dụ:
# postgres://studio:studio@127.0.0.1:5432/studio
DATABASE_URL=
PGSSLMODE=disable
PG_POOL_MAX=10

# ── AI: Content Engine (G09) ────────────────────────────────────────────────
# deepseek | openai | anthropic | gemini | mock
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=120000
AI_MAX_OUTPUT_TOKENS=4096
AI_TEMPERATURE=0.4

# ── AI: Vision Provider (G07) ───────────────────────────────────────────────
# Để trống = dùng chung cấu hình AI_* ở trên.
VISION_PROVIDER=
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
VISION_TIMEOUT_MS=120000
# Số ảnh tối đa gửi sang Vision trong một lần phân tích.
VISION_MAX_IMAGES=6

# ════════════════════════════════════════════════════════════════════════════
# MVP-02 — DỊCH CHỮ TRUNG TRÊN ẢNH SẢN PHẨM (ImageLab)
# Mặc định AN TOÀN: OCR_PROVIDER=mock + RENDER_PROVIDER=purejs — chạy offline,
# provider mock TỰ KHAI is_mock=true và UI hiện nhãn MOCK.
# ⚠️ OCR THẬT CẦN CẮM PROVIDER: đặt OCR_PROVIDER=http kèm OCR_BASE_URL + OCR_API_KEY
#    (adapter REST: POST baseUrl, body { image_base64, mime, width, height, max_regions },
#     chờ JSON { regions: [...] }). Không có provider thật thì hệ thống KHÔNG bịa vùng chữ:
#    trả status NOT_CONFIGURED.
# ════════════════════════════════════════════════════════════════════════════

# ── ImageLab: giới hạn chung ────────────────────────────────────────────────
# Bật/tắt toàn bộ tính năng dịch ảnh (true|false).
IMAGELAB_ENABLED=true
# Thư mục lưu ảnh gốc/ảnh render, TƯƠNG ĐỐI trong repo. Ảnh gốc BẤT BIẾN.
IMAGELAB_DIR=./data/imagelab
# Dung lượng tối đa của một ảnh tải lên (byte).
IMAGELAB_MAX_IMAGE_BYTES=8388608
# Số pixel tối đa của một ảnh (width*height) — chặn ảnh bom nén.
IMAGELAB_MAX_PIXELS=16000000
# Số vùng chữ tối đa giữ lại trên một ảnh (phần vượt bị cắt và ghi vào `dropped`).
IMAGELAB_MAX_REGIONS=200
# Ngưỡng độ tin cậy tối thiểu (0..1) để giữ một vùng chữ; dưới ngưỡng → bỏ kèm lý do.
IMAGELAB_MIN_CONFIDENCE=0.5
# Hệ số nhân cỡ chữ khi render chữ Việt vào hộp (1 = vừa khít hộp).
IMAGELAB_FONT_SCALE=1
# Dung lượng tối đa của ảnh kết quả (byte).
IMAGELAB_MAX_OUTPUT_BYTES=16777216

# ── OCR (C1) ────────────────────────────────────────────────────────────────
# mock = đọc vùng chữ từ fixture JSON (DỮ LIỆU DỰNG TAY, is_mock=true, KHÔNG phải OCR thật)
# http = adapter REST thật (cần OCR_BASE_URL + OCR_API_KEY) | none = tắt (NOT_CONFIGURED)
OCR_PROVIDER=mock
OCR_API_KEY=
OCR_BASE_URL=
OCR_MODEL=
# Timeout gọi provider OCR (ms).
OCR_TIMEOUT_MS=60000
# Fixture cho provider mock; còn có bản nhiều vùng bẩn để test nhánh fail-closed:
# src/imagelab/ocr/fixtures/mock-regions-noisy.json
OCR_MOCK_FIXTURE=src/imagelab/ocr/fixtures/mock-regions.json

# ── Render chữ Việt lên ảnh (C3) ────────────────────────────────────────────
# purejs = render offline bằng PNG thuần JS (không cần key) | mock | http | none
# Lưu ý: purejs chỉ hỗ trợ PNG; ảnh JPEG cần cắm provider http.
RENDER_PROVIDER=purejs
RENDER_API_KEY=
RENDER_BASE_URL=
RENDER_MODEL=
RENDER_TIMEOUT_MS=60000

# ── Dịch chữ trên ảnh (C2) ──────────────────────────────────────────────────
# Để trống = dùng chung cấu hình AI_* ở trên (giống VISION_*).
# mock = từ điển thuật ngữ, is_mock=true | ai = gọi AI thật | none = tắt
TRANSLATE_PROVIDER=
TRANSLATE_API_KEY=
TRANSLATE_BASE_URL=
TRANSLATE_MODEL=
TRANSLATE_TIMEOUT_MS=120000

# ── Session cho sàn cần đăng nhập (G05) ─────────────────────────────────────
# none  = chỉ truy cập ẩn danh, gặp tường đăng nhập thì báo LOGIN_REQUIRED
# file  = đọc cookie từ SESSION_COOKIE_FILE (file phải nằm ngoài git)
# cdp   = nối vào Chrome đang chạy với --remote-debugging-port (dùng profile thật)
SESSION_MODE=none
SESSION_COOKIE_FILE=./.session/cookies.json
CDP_ENDPOINT=http://127.0.0.1:9222
SESSION_REQUIRED_SOURCES=pinduoduo,taobao

# ── Network / Security ──────────────────────────────────────────────────────
# Chặn SSRF: cấm fetch vào IP nội bộ. Chỉ bật true khi test cục bộ có kiểm soát.
ALLOW_PRIVATE_NETWORK=false
# Timeout 1 request mạng ra ngoài (ms)
FETCH_TIMEOUT_MS=20000
# Số hop redirect tối đa; mỗi hop đều phải qua allowlist
FETCH_MAX_REDIRECTS=5
# Giới hạn dung lượng tải về cho 1 tài liệu/ảnh (byte)
MAX_FETCH_BYTES=8388608
# Giới hạn upload ảnh thủ công ở G11 (byte)
MAX_UPLOAD_BYTES=5242880
MAX_UPLOAD_FILES=12
# MIME được phép cho ảnh upload
ALLOWED_IMAGE_MIME=image/jpeg,image/png,image/webp,image/gif

# ── MVP-03: TẠO ẢNH (tách nền → ghép nền theo mẫu → retouch → overlay) ──────
# Bật/tắt cả tính năng. Tắt ⇒ cả 5 route /api/imagestudio/* trả 503 kèm lý do thật
# và /api/config báo imagestudio.available = false.
IMAGESTUDIO_ENABLED=true
# ⚠️ KHÔNG có biến thư mục riêng cho MVP-03: ảnh gốc VÀ ảnh tạo ra dùng CHUNG kho ảnh
# IMAGELAB_DIR ở trên (xem src/imagelab/storage.js). Đừng khai thêm biến thư mục nữa.

# Tách nền. Mặc định AN TOÀN: purejs — flood fill từ viền, chạy offline, không cần key.
#   purejs : chạy trong tiến trình, chỉ nhận PNG, fail-closed khi nền không đồng nhất
#   mock   : KHÔNG tách thật (mask giả cố định, is_mock = true) — chỉ để thử luồng
#   http   : gọi dịch vụ tách nền ngoài (CẦN MATTING_BASE_URL; MATTING_API_KEY nếu có)
#   none   : TẮT tách nền (mọi lượt trả NOT_CONFIGURED — không đoán, không cắt bừa)
MATTING_PROVIDER=purejs
MATTING_BASE_URL=
MATTING_API_KEY=
MATTING_MODEL=
MATTING_TIMEOUT_MS=60000

# Retouch (độ sáng/tương phản/bão hoà/nét). KHÔNG có provider http — 4 tham số này áp
# ngay trong tiến trình. `none` ⇒ mọi lượt retouch trả NOT_CONFIGURED.
RETOUCH_PROVIDER=purejs
RETOUCH_MODEL=
# Trần ngưỡng retouch. ⚠️ CHỈ SIẾT ĐƯỢC, KHÔNG NỚI: ngưỡng hiệu lực luôn là
# min(giá trị dưới đây, RETOUCH_LIMITS của hợp đồng §3.4 = 0.25/0.25/0.30/0.50).
# Khai số lớn hơn trần hợp đồng KHÔNG làm hệ thống cho vượt ngưỡng.
RETOUCH_MAX_BRIGHTNESS=0.25
RETOUCH_MAX_CONTRAST=0.25
RETOUCH_MAX_SATURATION=0.30
RETOUCH_MAX_SHARPEN=0.50

# ── Rate limit (abstraction in-memory; production nên thay bằng Redis) ──────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_JOBS=10
RATE_LIMIT_MAX_REQUESTS=120

# ── Jobs ────────────────────────────────────────────────────────────────────
# Concurrency của worker nền
JOB_CONCURRENCY=2
JOB_MAX_ATTEMPTS=2

# ── Usage / Billing foundation (G13) ────────────────────────────────────────
# Đơn giá ước tính để tính estimated_cost. Chưa thu tiền thật.
COST_SOURCE_EXTRACT=0.0005
COST_VISION_ANALYSIS=0.0030
COST_TRANSLATION=0.0008
COST_CONTENT_GENERATE=0.0040
# MVP-02: đơn giá ước tính cho 2 operation mới (OCR_DETECT, IMAGE_RENDER). Chưa thu tiền thật.
COST_OCR_DETECT=0.0004
COST_IMAGE_RENDER=0.0015
# MVP-03: đơn giá ước tính cho 3 operation mới (IMAGE_MATTING/IMAGE_COMPOSE/IMAGE_RETOUCH).
COST_IMAGE_MATTING=0.002
COST_IMAGE_COMPOSE=0.0005
COST_IMAGE_RETOUCH=0.0005
CREDIT_CURRENCY=USD

# ════════════════════════════════════════════════════════════════════════════
# MVP-05 — TÀI KHOẢN + VÍ CREDIT
# Mặc định AN TOÀN: AUTH_ENABLED=true, AUTH_ANONYMOUS_ALLOWED=true, BILLING_ENABLED=true.
# ⚠️ Chạy sau HTTPS (hoặc sau proxy TLS) thì đặt AUTH_SECURE_COOKIE=true để cookie phiên
#    không bị gửi qua http thường. Hệ thống CŨNG tự bật Secure khi PUBLIC_BASE_URL là https.
# ════════════════════════════════════════════════════════════════════════════

# ── Tài khoản & phiên đăng nhập ─────────────────────────────────────────────
# false = tắt hẳn đăng ký/đăng nhập (API /api/auth/* trả lỗi AUTH_DISABLED).
AUTH_ENABLED=true
# Tên cookie phiên (chỉ chứa [A-Za-z0-9._-]; sai định dạng sẽ rơi về mặc định).
AUTH_COOKIE_NAME=vauth
# Hạn phiên (ngày). Cookie giữ token THÔ; DB chỉ lưu sha256(token) nên cookie lộ cũng
# không đọc được token từ DB.
AUTH_SESSION_DAYS=30
# Độ dài tối thiểu của mật khẩu. ⚠️ CHỈ SIẾT ĐƯỢC, KHÔNG NỚI: sàn hợp đồng là 10,
# khai số nhỏ hơn 10 KHÔNG làm hệ thống nhận mật khẩu ngắn hơn.
AUTH_PASSWORD_MIN_LENGTH=10
# true = cookie phiên chỉ gửi qua HTTPS. ⚠️ BẬT khi chạy https; để false trên môi trường
# thật là lỗ hổng (cookie phiên đi qua http thường). Hệ thống tự bật khi PUBLIC_BASE_URL
# bắt đầu bằng https.
AUTH_SECURE_COOKIE=false
# true (mặc định) = vẫn dùng được ẩn danh theo session_id — luật #1: đăng nhập là TUỲ CHỌN,
# "dán link là chạy" không bị chặn.
# false = MỌI route đều phải đăng nhập, TRỪ /api/auth/*. Chỉ bật khi Owner muốn đóng hoàn
# toàn chế độ ẩn danh; bật false sẽ làm mọi luồng MVP-01/02/03 yêu cầu tài khoản.
AUTH_ANONYMOUS_ALLOWED=true

# ── Ví credit ───────────────────────────────────────────────────────────────
# false = tắt ví: không giữ/trừ credit, job chạy không tính tiền.
BILLING_ENABLED=true
# ⚠️ KHÔNG có biến tiền tệ riêng cho ví — dùng CHUNG CREDIT_CURRENCY ở trên.
# Credit tặng khi đăng ký (0 = không tặng). Số âm bị kẹp về 0.
BILLING_DEFAULT_GRANT=0
# true = giữ tiền TRƯỚC khi chạy job theo chi phí ước tính (thiếu ⇒ 402 trước khi tạo job,
# không tiêu tiền của người dùng rồi mới báo thiếu).
BILLING_HOLD_BEFORE_JOB=true
# true = seed bảng `pricing` từ các COST_* ở trên (nguồn giá mặc định của MVP-01).
BILLING_PRICING_FROM_COST=true
# Trần số LƯỢT CHẠY có tính tiền cho mỗi job (lượt đầu + mọi lượt chạy lại: regenerate/render/
# generate/retry). Vượt ⇒ HTTP 429 RERUN_LIMIT_EXCEEDED. Đặt 1 = mỗi job chỉ chạy 1 lượt.
BILLING_MAX_RUNS_PER_JOB=10
# Trần credit cho MỘT thao tác cấp/điều chỉnh (chặn `grant(1e308)`: trước đây sổ ghi amount=0
# mà API vẫn trả 201 ⇒ admin tin đã nạp tiền).
BILLING_MAX_AMOUNT=1000000000
# F3 (vòng vá PR #28): trần SỐ DƯ ví — cấp credit làm số dư VƯỢT trần ⇒ HTTP 400 AMOUNT_TOO_LARGE
# (sổ KHÔNG thêm dòng); điều chỉnh GIẢM không bị chặn. Vì sao cần: tiền là float8 nên chỉ giữ đủ
# 6 chữ số thập phân tới 2^53/1e6 = 9.007.199.254 credit; vượt mức đó thì phép trừ tiền nhỏ bị
# nuốt chữ số (đo được: số dư 1e11, 1.000 lượt trừ 0,0004 ⇒ lệch 2,83e-3). Mặc định 1000000000.
BILLING_MAX_BALANCE=1000000000
# Ngưỡng (ms) coi một LƯỢT CHẠY là TREO: có `job_hold` mà không có dòng đóng (settle/refund) —
# xảy ra khi tiến trình chết trước khi quyết toán hoặc sổ bị khoá. Quá ngưỡng ⇒ hệ thống HOÀN
# 100% khoản giữ và đóng lượt (job chạy lại được), lúc khởi động + trước khi trả 409, và bằng
# tay qua `POST /api/admin/billing/reconcile`. Mặc định 900000 (15 phút) — đủ dài để KHÔNG cắt
# ngang job đang chạy thật.
BILLING_STUCK_RUN_MS=900000
# ĐÁY AN TOÀN cho ngưỡng trên (ms). Ngưỡng TREO chỉ bị nâng lên đáy này khi đường gọi KHÔNG kiểm
# được job nào đang chạy; đường có kiểm tra (app boot / route / admin) dùng đúng ngưỡng cấu hình.
# Mặc định 60000 (1 phút) — không cho phép một cấu hình quá ngắn cắt ngang job thật.
BILLING_MIN_STUCK_RUN_MS=60000

# ── Owner đầu tiên (bootstrap) ──────────────────────────────────────────────
# ⚠️ Hệ thống mới tinh KHÔNG có owner/admin nào ⇒ không ai cấp được credit ⇒ ví vĩnh viễn 0
# ⇒ mọi job trả 402. Chọn MỘT trong hai:
#   1) Đặt OWNER_EMAIL=<email>: khi boot, nếu CHƯA có owner/admin thì user này được NÂNG lên
#      owner (chưa tồn tại thì TẠO mới; mật khẩu tạm in MỘT LẦN trong log — ĐỔI NGAY sau đó);
#   2) Chạy CLI (idempotent):  npm run make-owner -- <email> [mật khẩu]
# Không đặt gì và cũng chưa có owner ⇒ log ghi WARN hướng dẫn (không im lặng).
OWNER_EMAIL=
AUTH_ENABLED=true
AUTH_COOKIE_NAME=vauth
AUTH_SESSION_DAYS=30
AUTH_ANONYMOUS_ALLOWED=true
BILLING_ENABLED=true

# ── R1: hàng đợi BỀN (R1-Q) ─────────────────────────────────────────────────
# true (mặc định) = hàng đợi ghi DB TRƯỚC khi chạy ⇒ khởi động lại tiến trình KHÔNG mất việc
# đang chờ; mục đang chạy dở được khôi phục. false = chạy như cũ (trong bộ nhớ) — chỉ để
# so sánh/rollback, KHÔNG bền (mất việc khi restart).
QUEUE_DURABLE=true
# Ngưỡng (ms) coi một mục hàng đợi `running` là CHẾT (tiến trình giữ nó đã tắt) ⇒ trả về `queued`
# để chạy lại. Mặc định 600000 (10 phút) — dài hơn một job bình thường để không chạy đúp.
QUEUE_STALE_MS=600000
# Số lần thử TỐI ĐA cho một mục hàng đợi; hết lượt ⇒ `failed` + job `failed` (kẹp >= 1).
QUEUE_MAX_ATTEMPTS=3
# Backoff cơ sở (ms) khi handler lỗi: lần thử thứ n chờ `retryBaseMs * n`. Mặc định 2000.
QUEUE_RETRY_BASE_MS=2000

# ── R1: cron dọn dẹp định kỳ (R3-S) ─────────────────────────────────────────
# true (mặc định) = server chạy một nhịp định kỳ: thu hồi LƯỢT CHẠY TREO (ví bị giữ tiền mà
# không quyết toán — BILLING_STUCK_RUN_MS) và trả mục hàng đợi `running` quá cũ về hàng đợi
# (QUEUE_STALE_MS). false = KHÔNG tạo timer nào (health báo `scheduler.enabled=false`).
SCHEDULER_ENABLED=true
# Nhịp cron (ms). Mặc định 60000 (1 phút). Kẹp >= 1; timer được `unref()` nên KHÔNG giữ
# tiến trình sống khi server đã tắt.
SCHEDULER_INTERVAL_MS=60000
